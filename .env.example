# Copy to .env and fill in. Every key below maps to a field in settings.py
# (tests/unit/test_config.py fails if this file and Settings drift apart).

# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
USER_NAME=YourName
LOG_LEVEL=INFO

# Speech-to-text, HOPE's voice LLM, and the provider prefix litellm uses to
# look up the model's context window.
STT_MODEL=gpt-4o-mini-transcribe
LLM_MODEL=gpt-4.1-mini
LLM_PROVIDER=openai

# Langfuse tracing (https://langfuse.com — cloud or self-hosted)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Atlas, the filesystem agent. ATLAS_WORKSPACE is the ONLY directory it can touch.
ATLAS_LLM_MODEL=gpt-4o-mini
ATLAS_WORKSPACE=/absolute/path/to/a/folder/atlas/may/edit

# ── Voices (Kokoro voice ids) ─────────────────────────────────────────────────
# KOKORO_VOICE_ID=af_heart
# KOKORO_ATLAS_VOICE_ID=af_bella

# ── Internet access (self-hosted meta-search, read-only) ──────────────────────
# SEARCH_PROVIDER=degoog            # or: searxng
# DEGOOG_URL=http://localhost:4444
# DEGOOG_API_KEY=                   # only if your degoog instance protects /api/search
# SEARXNG_URL=http://localhost:8888
# DEGOOG_AUTOSTART=true             # HOPE starts degoog itself (Bun, else Docker)
# DEGOOG_DIR=                       # where HOPE builds degoog (default data_store/degoog)

# ── Sub-agents / deep research ────────────────────────────────────────────────
# MAX_LIVE_SUBAGENTS=5
# RESEARCH_LLM_MODEL=gpt-4o-mini
# RESEARCH_MAX_RESEARCHERS=4
# RESEARCH_MAX_TOOL_CALLS=12

# ── Context management ────────────────────────────────────────────────────────
# LLM_CONTEXT_LIMIT=128000          # fallback only; real window is looked up per model
# CONTEXT_SUMMARIZE_THRESHOLD=0.9
# CONTEXT_KEEP_RECENT=6
# SUMMARIZER_MODEL=gpt-4o-mini

# ── Location for the dashboard's weather card ─────────────────────────────────
# Leave empty to auto-detect from your IP. Set these if it guesses wrong (e.g. behind a VPN).
# HOME_CITY=
# HOME_LAT=
# HOME_LON=

# ── Dashboard ─────────────────────────────────────────────────────────────────
# DASHBOARD_AUTOSTART=true
# DASHBOARD_OPEN_BROWSER=true
