{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tests: All",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-v", "--tb=short"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Tests: Unit only",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-m", "unit", "-v", "--tb=short"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Tests: Integration only",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-m", "integration", "-v", "--tb=short"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Tests: Contracts only",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-m", "contract", "-v", "--tb=short"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Tests: Current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "--tb=long"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "HOPE: Run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/hope.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
